{
  "memory_home": "~/.silly-memory",
  "observer_token_threshold": 6000,
  "reflector_token_threshold": 20000,
  "context_pack_token_cap": 16000,
  "daily_token_budget": 500000,
  "observe_model": "composer-2.5-fast",
  "reflect_model": "composer-2.5-fast",
  "auto_promote_confidence": 0.85,
  "git_snapshot_enabled": false,
  "git_snapshot_auto_commit": false,
  "observe_activity": false,
  "observe_agent_responses": true,
  "events_max_lines": 5000,
  "tools": ["cursor"],
  "mcp": false,
  "path_denylist": [
    "~/.silly-memory",
    "~/.cursor/hooks",
    "~/.claude/hooks",
    "~/.claude/settings.json",
    "~/.claude/rules",
    "~/.config/opencode/plugins",
    ".env",
    ".env.*",
    "**/secrets/**",
    "**/credentials*",
    "**/*.pem",
    "**/*.key",
    "**/id_rsa*"
  ],
  "bank_files": [
    "README.md",
    "learned-memories.md",
    "audienceContext.md",
    "conventions.md",
    "activeContext.md",
    "actionItems.md",
    "domainContext.md",
    "progress.md",
    "projectbrief.md"
  ],
  "global_bank_routes": {
    "preference": "learned-memories.md",
    "hard-rule": "learned-memories.md",
    "stakeholder": "audienceContext.md",
    "convention": "conventions.md"
  },
  "workspace_bank_routes": {
    "decision": "domainContext.md",
    "action-item": "actionItems.md",
    "active-focus": "activeContext.md",
    "milestone": "progress.md",
    "project-status": "activeContext.md",
    "scope": "projectbrief.md"
  }
}
